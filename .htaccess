Options -Indexes

# ── HTTPS ──────────────────────────────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── www → sem www ──────────────────────────────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ── Redirecionamentos 301 – URLs antigas (sem .html) ───────────────────────
RewriteRule ^georreferenciamento/?$                  /georreferenciamento-incra.html [L,R=301]
RewriteRule ^georreferenciamento-incra/?$            /georreferenciamento-incra.html [L,R=301]
RewriteRule ^georreferenciamento-rural/?$            /georreferenciamento-incra.html [L,R=301]
RewriteRule ^georreferenciamento-rural-preco/?$      /blog-georreferenciamento-preco-hectare.html [L,R=301]
RewriteRule ^georreferenciamento-preco/?$            /blog-georreferenciamento-preco-hectare.html [L,R=301]
RewriteRule ^topografia/?$                           /topografia-levantamento-planialtimetrico.html [L,R=301]
RewriteRule ^topografia-georreferenciamento/?$       /topografia-levantamento-planialtimetrico.html [L,R=301]
RewriteRule ^servico-topografia-drone/?$             /mapeamento-com-drones.html [L,R=301]
RewriteRule ^empresa-topografia-drone/?$             /mapeamento-com-drones.html [L,R=301]
RewriteRule ^empresa-topografia/?$                   /sobre.html [L,R=301]
RewriteRule ^empresa-topografia-georreferenciamento/?$ /sobre.html [L,R=301]
RewriteRule ^supressao-vegetal/?$                    /blog-supressao-vegetal-dof.html [L,R=301]
RewriteRule ^agricultura-precisao/?$                 /blog-ndvi-agricultura-precisao.html [L,R=301]
RewriteRule ^agricultura-precisao-fruticultura/?$    /blog-agricultura-precisao-ms.html [L,R=301]
RewriteRule ^projeto-terraplenagem/?$                /blog-projeto-terraplenagem.html [L,R=301]
RewriteRule ^projeto-usucapiao/?$                    /blog-usucapiao.html [L,R=301]
RewriteRule ^georreferenciamento-campo-grande/?$     /georreferenciamento-campo-grande-ms.html [L,R=301]
RewriteRule ^georreferenciamento-dourados/?$         /georreferenciamento-dourados-ms.html [L,R=301]
RewriteRule ^drone-agricultura-precisao/?$           /drone-mapeamento-agricultura-precisao-ms.html [L,R=301]

# ── Página de erro personalizada ───────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Cache de assets estáticos ──────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType text/css              "access plus 3 months"
  ExpiresByType application/javascript "access plus 3 months"
  ExpiresByType text/html             "access plus 1 day"
</IfModule>

# ── Compressão Gzip ────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain
</IfModule>

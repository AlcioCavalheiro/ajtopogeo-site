# Copie este arquivo para .env.local e preencha a chave.
# .env.local está no .gitignore e no .vercelignore — nunca vai para o Git nem para o site.
#
# Onde pegar a service_role key:
#   https://supabase.com/dashboard/project/wwmlrifoxnekhgppikxa/settings/api-keys
#   Seção "Project API keys" -> service_role -> Reveal -> copiar
#
# ATENÇÃO: a service_role ignora RLS. Ela só deve existir neste arquivo local.
# Nunca cole ela no gestor/index.html nem em qualquer arquivo versionado.

SUPABASE_URL=https://wwmlrifoxnekhgppikxa.supabase.co
SUPABASE_SERVICE_KEY=cole_a_service_role_key_aqui
